<Project Sdk="Microsoft.NET.Sdk">
  <!-- JJQR - AI (Nov 21, 2026) - allen5: proves the SQLCipher swap end to end (EF Core + allen2's sync outbox on an encrypted DB, migration,
       backup/restore). Uses EXACTLY the package changes proposed for ClinicNode.App.csproj, so it also validates that snippet.
       Lives outside ClinicNode.Tests because that csproj (shared) must not get the bundle swap. Run: dotnet test packaging/sqlcipher-tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- the swap: SQLCipher native + batteries; keep the transitive e_sqlite3 bundle (from Microsoft.EntityFrameworkCore.Sqlite) out -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../ClinicNode/ClinicNode.Core/ClinicNode.Core.csproj" />
    <ProjectReference Include="../../ClinicNode/ClinicNode.Data/ClinicNode.Data.csproj" />
    <ProjectReference Include="../../ClinicNode/ClinicNode.Sync/ClinicNode.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- JJQR - END -->
</Project>
