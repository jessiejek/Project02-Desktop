<!-- JJQR - AI (21 Nov 2026) - 1:1 with web /admin/bookings: PageHeader "Bookings" + "New walk-in", List / Week view tabs.
     List tab (filter card, count line, table) is built in code-behind; the Week tab keeps its bound header and code-built grid. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicNode.App.Views.Admin.AdminBookingsPage"
             Title="Bookings"
             BackgroundColor="{StaticResource Background}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            <VerticalStackLayout x:Name="Header" Spacing="16" />
            <VerticalStackLayout x:Name="ListArea" Spacing="16" IsVisible="{Binding IsList}" />
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsWeek}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button Text="‹ Previous week" Style="{StaticResource SecondaryButton}" Command="{Binding PrevWeekCommand}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{Binding WeekLabel}" Style="{StaticResource HeadlineSm}" HorizontalTextAlignment="Center" />
                        <Button Text="Back to this week" Style="{StaticResource GhostButton}" Command="{Binding ThisWeekCommand}" IsVisible="{Binding IsAwayFromThisWeek}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="Next week ›" Style="{StaticResource SecondaryButton}" Command="{Binding NextWeekCommand}" VerticalOptions="Center" />
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <ScrollView Orientation="Horizontal">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid x:Name="WeekGrid" ColumnSpacing="0" RowSpacing="0" />
                    </Border>
                </ScrollView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<!-- JJQR - END -->
