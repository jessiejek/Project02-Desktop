<?xml version="1.0" encoding="UTF-8" ?>
<!-- JJQR - AI (Nov 21, 2026) - native consultation workspace: header, horizontal stepper, card host, footer actions. -->
<!-- JJQR - AI (21 Nov 2026) - 1:1 with web /doctor/consultation2: title + visit-type toggle + View Patient History / print / Cancel amendment in the header,
     numbered step pills with More/Less before the fee step (rendered in code), footer Prev / Next / Save & next / Review & complete, overlays for
     the Completion Checklist, Apply SOAP template, certificate confirm and "Consultation saved". Light theme only (StaticResource colours). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicNode.App.Views.Doctor.ConsultationPage"
             Title="Consultation"
             BackgroundColor="{StaticResource Background}">
    <!-- JJQR - AI (Nov 21, 2026) - desktop workspace: header row, then [steps | form | patient & visit summary], footer under the form -->
    <Grid x:Name="Root" ColumnDefinitions="262,*" RowDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16" RowSpacing="10" Padding="24,12,24,12">

        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="PageTitle" Text="Document consultation" Style="{StaticResource PageKicker}" />
                <!-- JJQR - AI (2026-11-26) - GAV-10: owner: "there must be an EDIT while consulting": "Edit details" (pencil) right beside the patient's name; opens the patient details pop-up, the consultation stays as typed -->
                <HorizontalStackLayout Spacing="10">
                    <Label x:Name="BannerName" Style="{StaticResource HeadlineMd}" VerticalOptions="Center" />
                    <Button x:Name="EditPatientButton" Text="Edit details" Style="{StaticResource SecondaryButton}" Clicked="OnEditPatientDetails" VerticalOptions="Center" Padding="10,4" MinimumHeightRequest="32" AutomationProperties.Name="Edit details" ToolTipProperties.Text="Edit the patient's details (name, birthday, contact, address, IDs…)" />
                    <!-- JJQR - AI (2026-11-26) - GAV-11: "Wrong patient?" right after Edit details: move THIS visit to a new or an existing patient (online only, syncs first) -->
                    <Button x:Name="WrongPatientButton" Text="Wrong patient?" Style="{StaticResource SecondaryButton}" Clicked="OnWrongPatient" VerticalOptions="Center" Padding="10,4" MinimumHeightRequest="32" ToolTipProperties.Text="This visit belongs to a different person: move it to a new or an existing patient" />
                    <!--JJQR - AI (2026-11-26) - GAV-12: "Merge to existing patient" right after "Wrong patient?" (ConsultationPage.MergePatient.cs) //JJQR - END-->
                    <Button x:Name="MergeExistingButton" Text="Merge to existing patient" Style="{StaticResource SecondaryButton}" Clicked="OnMergeExisting" VerticalOptions="Center" Padding="10,4" MinimumHeightRequest="32" ToolTipProperties.Text="This person was already registered before: merge this record into the existing one" />
                    <!-- JJQR - END -->
                </HorizontalStackLayout>
                <!-- JJQR - END -->
                <Label x:Name="BannerMeta" Style="{StaticResource MutedSm}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End" VerticalOptions="Center">
                <Button x:Name="HelpButton" Text="?" Style="{StaticResource SecondaryButton}" Clicked="OnHelp" Margin="8,0,0,0" ToolTipProperties.Text="Keyboard shortcuts" />
                <Button x:Name="HistoryButton" Text="Patient history" Style="{StaticResource SecondaryButton}" Clicked="OnHistory" Margin="8,0,0,0" />
                <!-- JJQR - AI (Nov 25, 2026) - owner: open the patient's chart during the consult (upload results, reprint). Opens on this visit. JJQR - END -->
                <Button x:Name="ChartButton" Text="Patient chart" Style="{StaticResource SecondaryButton}" Clicked="OnOpenChart" Margin="8,0,0,0" />
                <Button x:Name="PrintRxButton" Text="Print prescription" Style="{StaticResource SecondaryButton}" Clicked="OnPrintRx" Margin="8,0,0,0" />
                <Button x:Name="PrintLabsButton" Text="Print lab orders" Style="{StaticResource SecondaryButton}" Clicked="OnPrintLabs" Margin="8,0,0,0" />
                <Button x:Name="PrintCertButton" Text="Print certificate" Style="{StaticResource SecondaryButton}" Clicked="OnPrintCert" Margin="8,0,0,0" />
                <Button x:Name="SaveCertButton" Text="Save certificate" Style="{StaticResource SecondaryButton}" Clicked="OnSaveCert" IsVisible="False" Margin="8,0,0,0" />
                <Button x:Name="PrintSlipButton" Text="Print queue slip" Style="{StaticResource SecondaryButton}" Clicked="OnPrintSlip" Margin="8,0,0,0" />
                <Button x:Name="CancelAmendButton" Text="Cancel amendment" Style="{StaticResource SecondaryButton}" Clicked="OnCancelAmend" IsVisible="False" Margin="8,0,0,0" />
            </HorizontalStackLayout>
        </Grid>

        <!-- steps rail -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <ScrollView>
                <VerticalStackLayout Spacing="6">
                    <Label Text="STEPS" Style="{StaticResource LabelSm}" Margin="8,4,0,4" />
                    <VerticalStackLayout x:Name="StepBar" Spacing="4" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- form -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
            <ScrollView>
                <VerticalStackLayout x:Name="SectionHost" Spacing="14" />
            </ScrollView>
        </Border>

        <!-- patient / visit / fee: one tidy strip ABOVE the work area (aligned blocks, labels on top, content on one line) -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="20,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="48" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0" Text="PATIENT" Style="{StaticResource LabelSm}" />
                <Label Grid.Row="0" Grid.Column="1" Text="VISIT TYPE" Style="{StaticResource LabelSm}" />
                <Label Grid.Row="0" Grid.Column="2" Text="FEE" Style="{StaticResource LabelSm}" />
                <VerticalStackLayout Grid.Row="1" Grid.Column="0" x:Name="AllergyBar" Spacing="6" VerticalOptions="Start" />
                <VerticalStackLayout Grid.Row="1" Grid.Column="1" x:Name="VisitTypeBar" Spacing="4" VerticalOptions="Start" />
                <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="0" VerticalOptions="Start" MinimumWidthRequest="190">
                    <Label x:Name="FeeTotal" FontFamily="InterSemiBold" FontSize="24" TextColor="{StaticResource Primary}" />
                    <Label x:Name="FeePreview" Style="{StaticResource MutedSm}" MaximumWidthRequest="300" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- footer under the form -->
        <!-- JJQR - AI (Nov 23, 2026) - owner: "the working area is too small". The save messages used to stack ABOVE the buttons (2-3 extra lines); now they sit on the LEFT of the buttons in one row. -->
        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
            <Label x:Name="StatusLabel" Style="{StaticResource MutedSm}" MaxLines="2" LineBreakMode="TailTruncation" />
            <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" MaxLines="2" LineBreakMode="TailTruncation" />
            <HorizontalStackLayout x:Name="ToastBar" Spacing="8" IsVisible="False">
                <Label x:Name="ToastLabel" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                <Button x:Name="ToastAction" Text="Undo" Style="{StaticResource GhostButton}" Clicked="OnToastAction" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                <ActivityIndicator x:Name="FooterSpinner" IsRunning="False" IsVisible="False" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Margin="8,0,0,0" Color="{StaticResource Primary}" SemanticProperties.Description="Saving" />
                <Button x:Name="PrevButton" Text="Prev" Style="{StaticResource SecondaryButton}" Clicked="OnPrev" Margin="8,0,0,0" />
                <Button x:Name="NextButton" Text="Next" Style="{StaticResource SecondaryButton}" Clicked="OnNext" Margin="8,0,0,0" />
                <Button x:Name="AmendButton" Text="Edit Consultation" Style="{StaticResource SecondaryButton}" Clicked="OnAmend" IsVisible="False" Margin="8,0,0,0" />
                <Button x:Name="SaveNextButton" Text="Save &amp; next" Style="{StaticResource SecondaryButton}" Clicked="OnSaveNext" Margin="8,0,0,0" />
                <Button x:Name="CompleteButton" Text="Review &amp; complete" Style="{StaticResource PrimaryButton}" Clicked="OnComplete" Margin="8,0,0,0" />
            </HorizontalStackLayout>
        </Grid>
        <!-- JJQR - END -->

        <!-- JJQR - AI (Nov 21, 2026) - floating dropdown layer: panels open OVER the page so nothing below moves -->
        <AbsoluteLayout x:Name="PopupLayer" Grid.RowSpan="4" Grid.ColumnSpan="2" IsVisible="False" ZIndex="15" BackgroundColor="Transparent" />
        <!-- JJQR - END -->

        <!-- JJQR - AI (Nov 21, 2026) - real modal: dimmed backdrop + floating card with title bar and close -->
        <Grid x:Name="Overlay" Grid.RowSpan="4" Grid.ColumnSpan="2" IsVisible="False" ZIndex="10" BackgroundColor="#B3102A28">
            <Border x:Name="OverlayCard" BackgroundColor="{StaticResource SurfaceContainerLowest}" Stroke="#73808A94" StrokeThickness="1" Padding="0"
                    MaximumWidthRequest="880" HorizontalOptions="Center" VerticalOptions="Center" Margin="28">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="Black" Opacity="0.38" Radius="32" Offset="0,12" /></Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <Grid BackgroundColor="{StaticResource SurfaceContainerLow}" Padding="22,12,14,12" ColumnDefinitions="*,Auto">
                        <Label x:Name="OverlayTitle" FontFamily="InterSemiBold" FontSize="17" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" FontSize="15" BackgroundColor="Transparent" TextColor="{StaticResource OnSurfaceVariant}" BorderWidth="0"
                                Padding="0" WidthRequest="34" HeightRequest="34" MinimumHeightRequest="34" MinimumWidthRequest="34" CornerRadius="17"
                                Clicked="OnOverlayClose" SemanticProperties.Description="Close" ToolTipProperties.Text="Close" />
                    </Grid>
                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource OutlineVariant}" />
                    <!-- JJQR - AI (Nov 23, 2026) - owner (Windows laptop): "I can't complete it". A fixed 560 here plus the title was taller than the page, so the Confirm & Complete row was cut off. The height now follows the window (code-behind FitOverlay). -->
                    <ScrollView x:Name="OverlayScroll" Grid.Row="2" MaximumHeightRequest="560"><VerticalStackLayout x:Name="OverlayBody" Spacing="10" Padding="22,18" /></ScrollView>
                    <BoxView Grid.Row="3" HeightRequest="1" Color="{StaticResource OutlineVariant}" />
                    <FlexLayout x:Name="OverlayActions" Grid.Row="4" Wrap="Wrap" JustifyContent="End" BackgroundColor="{StaticResource SurfaceContainerLow}" Padding="22,12,22,4" />
                </Grid>
            </Border>
        </Grid>
        <!-- JJQR - END -->
    </Grid>
</ContentPage>
<!-- JJQR - END -->
