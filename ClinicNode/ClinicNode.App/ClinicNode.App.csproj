<Project Sdk="Microsoft.NET.Sdk">
  <!-- JJQR - AI (Nov 21, 2026) - native MAUI Clinic Node. No WebView product UI, no Node. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- net10.0 is a class-library TFM so tests can build the real service graph and resolve Pages/ViewModels -->
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
    <RootNamespace>ClinicNode.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Clinic Node</ApplicationTitle>
    <ApplicationId>ph.clinicnode.app</ApplicationId>
    <ApplicationDisplayVersion>0.2.4</ApplicationDisplayVersion>
    <ApplicationVersion>6</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <EnableCodeSigning Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">false</EnableCodeSigning>
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
  </PropertyGroup>

  <!-- JJQR - AI (Nov 22, 2026) - "production defaults" switch for the packaged app: dotnet build -p:ClinicProd=true. A true Release build of this app crashes at start (the trimmer + ahead-of-time compiler used for Mac Release builds break the XAML/reflection code; fixing that is a separate job),
       so the DMG is made from the normal (JIT) build with these production defaults: live server address, demo mode off, developer log off. -->
  <PropertyGroup Condition="'$(ClinicProd)' == 'true'">
    <DefineConstants>$(DefineConstants);CLINIC_PROD</DefineConstants>
  </PropertyGroup>
  <!-- JJQR - END -->

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#00685F" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#00685F" BaseSize="128,128" />
    <MauiFont Include="Resources/Fonts/Inter-Regular.ttf" />
    <MauiFont Include="Resources/Fonts/Inter-Medium.ttf" />
    <MauiFont Include="Resources/Fonts/Inter-SemiBold.ttf" />
    <MauiFont Include="Resources/Fonts/fa-solid-900.ttf" />
    <MauiFont Include="Resources/Fonts/fa-regular-400.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClinicNode.Core/ClinicNode.Core.csproj" />
    <ProjectReference Include="../ClinicNode.Data/ClinicNode.Data.csproj" />
    <ProjectReference Include="../ClinicNode.Sync/ClinicNode.Sync.csproj" />
    <!-- JJQR - AI (Nov 21, 2026) - online-first API layer (docs/ONLINE-FIRST.md) -->
    <ProjectReference Include="../ClinicNode.Api/ClinicNode.Api.csproj" />
    <!-- JJQR - END -->
  </ItemGroup>

  <!-- JJQR - AI (Nov 21, 2026) - net10.0 test TFM has no native app host; drop NativeReference so ResolveNativeReference is not invoked -->
  <Target Name="StripNativeReferencesForNet10" BeforeTargets="ResolveNativeReferences;_SanitizeNativeReferences;_ExpandNativeReferences"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <NativeReference Remove="@(NativeReference)" />
    </ItemGroup>
  </Target>

  <!-- JJQR - AI (Nov 21, 2026) - Mac Catalyst launch: do not link the macOS-only MSAL dylib
       (SIGKILL / Code Signature Invalid on macOS 27), then ad-hoc-sign the finished .app
       with sealed resources and fail the build if the signature is invalid. -->
  <Target Name="StripMacOsOnlyMsalRuntime" BeforeTargets="_SanitizeNativeReferences;_ExpandNativeReferences"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <ItemGroup>
      <_MsalNativeReference Include="@(NativeReference)" Condition="$([System.String]::Copy('%(Identity)').Contains('msalruntime'))" />
      <NativeReference Remove="@(_MsalNativeReference)" />
    </ItemGroup>
    <Message Importance="high" Text="Clinic Node: removed macOS-only MSAL native library from the Mac Catalyst app: @(_MsalNativeReference)" Condition="'@(_MsalNativeReference)' != ''" />
  </Target>

  <Target Name="AdHocSignAndVerifyMacCatalystApp" AfterTargets="Build"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <PropertyGroup>
      <_ClinicNodeAppBundle Condition="Exists('$(OutputPath)Clinic Node.app')">$(OutputPath)Clinic Node.app</_ClinicNodeAppBundle>
      <_ClinicNodeAppBundle Condition="'$(_ClinicNodeAppBundle)' == '' And Exists('$(OutputPath)$(AssemblyName).app')">$(OutputPath)$(AssemblyName).app</_ClinicNodeAppBundle>
    </PropertyGroup>
    <Error Condition="'$(_ClinicNodeAppBundle)' == ''" Text="Clinic Node: Mac Catalyst app bundle was not found under $(OutputPath)" />
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../scripts/sign-maccatalyst-app.sh&quot; &quot;$(_ClinicNodeAppBundle)&quot; &quot;$(MSBuildThisFileDirectory)Platforms/MacCatalyst/Entitlements.plist&quot; &quot;$(MSBuildThisFileDirectory)Platforms/MacCatalyst/msalruntime_stub.c&quot;" />
  </Target>
</Project>

